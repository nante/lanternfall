{
  "name": "lanternfall",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n world,client 'npm:dev:server' 'npm:dev:client'",
    "dev:server": "tsx watch --include content/balance.json apps/server/src/index.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "host": "tsx scripts/host.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "electron apps/desktop/main.cjs",
    "studio": "vite --config apps/studio/vite.config.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.27",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "^0.18.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "8.3.6"
  }
}
